---
import { process } from '../data/site';
---

<section class="section container" id="proceso">
	<div class="section-head reveal">
		<p class="eyebrow">Cómo trabajo</p>
		<h2 class="section-title">Un proceso simple y sin sorpresas</h2>
	</div>

	<ol class="steps">
		{process.map((step, i) => (
			<li class="step reveal" style={`--delay: ${i * 0.08}s`}>
				<span class="step__num">{String(i + 1).padStart(2, '0')}</span>
				<h3 class="step__title">{step.title}</h3>
				<p class="step__text">{step.text}</p>
			</li>
		))}
	</ol>
</section>

<style>
	.steps {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		margin: 0;
		padding: 0;
		list-style: none;
		border-top: 2px solid var(--ink);
	}

	.step {
		display: grid;
		align-content: start;
		gap: 14px;
		padding: 28px 24px 8px 0;
		position: relative;
	}

	.step + .step {
		padding-left: 24px;
		border-left: 1px solid var(--line);
	}

	/* Punto sobre la línea */
	.step::before {
		content: '';
		position: absolute;
		top: -9px;
		left: 0;
		width: 16px;
		height: 16px;
		border-radius: 50%;
		background: var(--paper);
		border: 2px solid var(--ink);
		transition: background 0.3s;
	}

	.step + .step::before {
		left: 24px;
	}

	.step:hover::before {
		background: var(--coral);
	}

	.step__num {
		font-family: var(--font-mono);
		font-size: 0.875rem;
		color: var(--blue);
	}

	.step__title {
		font-size: clamp(1.25rem, 2vw, 1.5rem);
	}

	.step__text {
		color: var(--ink-soft);
	}

	@media (max-width: 900px) {
		.steps {
			grid-template-columns: 1fr 1fr;
			border-top: 0;
			gap: 0 24px;
		}
		.step,
		.step + .step {
			padding: 28px 0 24px;
			border-left: 0;
			border-top: 2px solid var(--ink);
		}
		.step + .step::before {
			left: 0;
		}
	}

	@media (max-width: 560px) {
		.steps {
			grid-template-columns: 1fr;
		}
	}
</style>
