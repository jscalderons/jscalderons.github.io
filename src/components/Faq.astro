---
import { faqs } from '../data/site';
---

<section class="section container" id="preguntas">
	<div class="faq">
		<div class="section-head reveal">
			<p class="eyebrow">Preguntas frecuentes</p>
			<h2 class="section-title">Lo que suelen preguntarme</h2>
		</div>

		<div class="faq__list">
			{faqs.map((f, i) => (
				<details class="faq__item reveal" style={`--delay: ${Math.min(i, 3) * 0.05}s`}>
					<summary>
						<span>{f.q}</span>
						<span class="faq__icon" aria-hidden="true"></span>
					</summary>
					<p>{f.a}</p>
				</details>
			))}
		</div>
	</div>
</section>

<script type="application/ld+json" set:html={JSON.stringify({
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqs.map((f) => ({
		'@type': 'Question',
		name: f.q,
		acceptedAnswer: { '@type': 'Answer', text: f.a },
	})),
})} />

<style>
	.faq {
		display: grid;
		grid-template-columns: 1fr 1.4fr;
		gap: clamp(24px, 5vw, 72px);
		align-items: start;
	}

	.faq .section-head {
		position: sticky;
		top: 110px;
	}

	.faq__list {
		border-top: 2px solid var(--ink);
	}

	.faq__item {
		border-bottom: 1px solid var(--line);
	}

	summary {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 20px;
		padding: 24px 0;
		cursor: pointer;
		list-style: none;
		font-family: var(--font-display);
		font-weight: 700;
		font-size: clamp(1.15rem, 1.8vw, 1.4rem);
		line-height: 1.2;
		letter-spacing: -0.02em;
	}

	summary::-webkit-details-marker {
		display: none;
	}

	.faq__icon {
		position: relative;
		flex: none;
		width: 36px;
		height: 36px;
		border: 2px solid var(--ink);
		border-radius: 50%;
		transition: background 0.2s, transform 0.3s var(--ease);
	}

	.faq__icon::before,
	.faq__icon::after {
		content: '';
		position: absolute;
		inset: 50% auto auto 50%;
		width: 14px;
		height: 2px;
		background: currentColor;
		translate: -50% -50%;
	}

	.faq__icon::after {
		rotate: 90deg;
		transition: rotate 0.3s var(--ease);
	}

	details[open] .faq__icon {
		background: var(--sun);
	}

	details[open] .faq__icon::after {
		rotate: 0deg;
	}

	summary:hover .faq__icon {
		background: var(--sun);
	}

	.faq__item p {
		padding: 0 56px 24px 0;
		color: var(--ink-soft);
		max-width: 62ch;
	}

	@media (max-width: 860px) {
		.faq {
			grid-template-columns: 1fr;
		}
		.faq .section-head {
			position: static;
		}
		.faq__item p {
			padding-right: 0;
		}
	}
</style>
