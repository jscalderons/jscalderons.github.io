---
import { site, highlights } from '../data/site';
---

<section class="section exp" id="sobre-mi">
	<div class="container exp__inner">
		<div class="section-head reveal">
			<p class="eyebrow">Sobre mí</p>
			<h2 class="section-title">Experiencia de empresa, trato de persona a persona</h2>
			<p class="exp__lead">
				Soy {site.name}, desarrollador en {site.location}. He trabajado en empresas grandes y con negocios pequeños,
				y eso me permite darte soluciones serias sin complicarte la vida.
			</p>
		</div>

		<ul class="highlights">
			{highlights.map((h, i) => (
				<li class="highlight reveal" style={`--delay: ${i * 0.06}s`}>
					<span class="highlight__value">{h.value}</span>
					<p>{h.text}</p>
				</li>
			))}
		</ul>

		<a class="exp__more reveal" href={site.linkedin} target="_blank" rel="noopener">
			Ver mi trayectoria completa en LinkedIn →
		</a>
	</div>
</section>

<style>
	.exp {
		background: var(--ink);
		color: var(--paper);
		border-radius: clamp(28px, 5vw, 56px);
		margin-inline: clamp(8px, 1.5vw, 16px);
	}

	.exp .eyebrow {
		color: var(--sun);
	}

	.exp__lead {
		max-width: 52ch;
		font-size: clamp(1.05rem, 1.5vw, 1.2rem);
		color: rgb(243 239 230 / 0.78);
	}

	.highlights {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 14px;
	}

	.highlight {
		display: grid;
		align-content: start;
		gap: 12px;
		padding: 26px;
		border: 1px solid rgb(243 239 230 / 0.2);
		border-radius: 22px;
		transition: border-color 0.3s, transform 0.35s var(--ease);
	}

	.highlight:hover {
		border-color: var(--sun);
		transform: translateY(-4px);
	}

	.highlight__value {
		font-family: var(--font-display);
		font-weight: 800;
		font-size: clamp(1.8rem, 3vw, 2.4rem);
		line-height: 1;
		letter-spacing: -0.03em;
		color: var(--sun);
	}

	.highlight p {
		color: rgb(243 239 230 / 0.78);
	}

	.exp__more {
		display: inline-block;
		margin-top: 36px;
		font-weight: 700;
		text-underline-offset: 4px;
	}

	@media (max-width: 960px) {
		.highlights {
			grid-template-columns: 1fr 1fr;
		}
	}

	@media (max-width: 560px) {
		.highlights {
			grid-template-columns: 1fr;
		}
	}
</style>
